# Django-only settings
SECRET_KEY=your-secret-key
DEBUG=False
ALLOWED_HOSTS=your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Django logging settings
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# Django database settings
DATABASE_URL=postgres://user:password@host:5432/database
DB_SCHEMA=gea

# Django media storage settings
MEDIAFILES_PROVIDER=s3
MEDIAFILES_LOCATION=media
MEDIA_URL=/media/
MEDIA_ROOT=media

# Django staticfiles settings
STATICFILES_PROVIDER=whitenoise
STATIC_URL=/static/
STATIC_ROOT=staticfiles
STATICFILES_LOCATION=static

# Shared remote storage settings
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_DEFAULT_ACL=
AWS_S3_FILE_OVERWRITE=False
AWS_QUERYSTRING_AUTH=True
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=virtual

# Django mail settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@localhost

# Shared async infrastructure
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Optional integration tests
RUN_STORAGE_INTEGRATION_TESTS=False
RUN_MAIL_INTEGRATION_TESTS=False
RUN_ASYNC_MAIL_INTEGRATION_TESTS=False
MAILHOG_MESSAGES_API_URL=http://127.0.0.1:8025/api/v2/messages
MAILHOG_WAIT_TIMEOUT_SECONDS=20
MAILHOG_POLL_INTERVAL_SECONDS=0.25

# Docker-only settings
POSTGRES_DB=gea_trader
POSTGRES_USER=luscious
POSTGRES_PASSWORD=blue
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=gea-trader

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
REDIS_PORT=6379
