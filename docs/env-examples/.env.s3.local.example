# Django-only settings
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Django database settings
DATABASE_URL=postgres://luscious:blue@localhost:5432/gea_trader
DB_SCHEMA=gea

# Django media storage settings
MEDIAFILES_PROVIDER=s3
MEDIAFILES_LOCATION=media
MEDIA_URL=/media/
MEDIA_ROOT=media

# Django staticfiles settings
STATICFILES_PROVIDER=local
STATIC_URL=/static/
STATIC_ROOT=staticfiles
STATICFILES_LOCATION=static

# Shared remote storage settings
AWS_STORAGE_BUCKET_NAME=gea-trader
AWS_ACCESS_KEY_ID=luscious
AWS_SECRET_ACCESS_KEY=blue_luscious
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_S3_CUSTOM_DOMAIN=
# AWS_DEFAULT_ACL=
AWS_S3_FILE_OVERWRITE=False
AWS_QUERYSTRING_AUTH=True
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path

# Optional integration tests
RUN_STORAGE_INTEGRATION_TESTS=True

# Docker-only settings
POSTGRES_DB=gea_trader
POSTGRES_USER=luscious
POSTGRES_PASSWORD=blue
POSTGRES_PORT=5432

MINIO_ROOT_USER=luscious
MINIO_ROOT_PASSWORD=blue_luscious
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=gea-trader
